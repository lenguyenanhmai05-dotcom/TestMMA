rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isValidRating(data) {
      return !('rating' in data) 
        || data.rating == null 
        || (data.rating is int && data.rating >= 0 && data.rating <= 5)
        || (data.rating is number && data.rating >= 0 && data.rating <= 5 && int(data.rating) == data.rating);
    }
    
    function isValidNotes(data) {
      return !('notes' in data) 
        || data.notes == null 
        || (data.notes is string && data.notes.size() <= 300);
    }
    
    function isValidFavorite(data) {
      return !('favorite' in data) 
        || data.favorite is bool;
    }
    
    function isValidBookData(data) {
      return data.userId is string
        && data.userId == request.auth.uid
        && data.title is string
        && data.title.trim().size() > 0
        && data.title.size() <= 100
        && data.author is string
        && data.author.trim().size() > 0
        && data.author.size() <= 60
        && data.genre in ['Fiction', 'Non-Fiction', 'Academic', 'Other']
        && data.status in ['To Read', 'Reading', 'Finished']
        && isValidRating(data)
        && isValidNotes(data)
        && isValidFavorite(data);
    }

    match /books/{bookId} {
      // 1. Only logged-in users can read their own books; visitors cannot read anything
      allow read: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid);
      
      // 2. Reject if userId is not the logged-in user, or if invalid data (length, enum, etc.)
      allow create: if isAuthenticated() 
        && request.resource.data.userId == request.auth.uid
        && isValidBookData(request.resource.data);
        
      // 3. Only the owner can update their book with valid data; cannot change owner
      allow update: if isAuthenticated()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && isValidBookData(request.resource.data);
        
      // 4. Only the owner can delete their book
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
  }
}
